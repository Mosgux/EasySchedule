# 数据库配置
DATABASE_URL="file:./data/easy.db"

# 服务器配置
PORT=4000
NODE_ENV=development

# 安全配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
NANOID_SIZE=12

# 日志配置
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# 缓存配置 (可选)
REDIS_URL=redis://localhost:6379

# 清理任务配置
CLEANUP_INTERVAL="0 2 * * *" # 每天凌晨2点清理